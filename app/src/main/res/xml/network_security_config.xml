<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS. No se confía en certificados de usuario ni se desactiva la validación SSL. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
