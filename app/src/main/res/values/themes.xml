<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PelisHD4K" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="alertDialogTheme">@style/TvDialog</item>
    </style>

    <!-- Pantalla de inicio: se muestra al instante mientras carga la interfaz, sin Activity extra. -->
    <style name="Theme.PelisHD4K.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="TvDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/accent_bright</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TvDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TvDialogButton</item>
    </style>

    <style name="TvDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minWidth">96dp</item>
    </style>

    <style name="TabItem" parent="">
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SectionTitle" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TvButton" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
