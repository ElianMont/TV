<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="208dp"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="22dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tabHome"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/tab_home" />

        <TextView
            android:id="@+id/tabMovies"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_movies" />

        <TextView
            android:id="@+id/tabSeries"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_series" />

        <TextView
            android:id="@+id/tabTrending"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_trending" />

        <TextView
            android:id="@+id/tabFavorites"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_favorites" />

        <TextView
            android:id="@+id/tabContinue"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_continue" />

        <TextView
            android:id="@+id/tabSearch"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_search" />

        <TextView
            android:id="@+id/tabSettings"
            style="@style/TabItem"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:text="@string/tab_settings" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false" />
</LinearLayout>
